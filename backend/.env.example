# Copy to backend/.env and adjust the password/port to your local PostgreSQL.
# Never commit backend/.env. On a host, set these as server-side secrets instead.
DATABASE_URL="postgresql://shopsmart_user:shopsmart_dev@localhost:5432/shopsmart?schema=public"
PORT=3000
FRONTEND_URL=http://localhost:5173
NODE_ENV=development
# Optional: leave blank to use the verified rule-based assistant.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
